# ============================================================================
# Bahrd — template do ambiente de PRODUÇÃO.
#
# Copie para `.env.prod` NA MÁQUINA e preencha. Este arquivo é template: o
# `.env.prod` de verdade está no `.gitignore` e nunca entra no repositório.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# O que muda em relação ao `.env.example` (que é o de desenvolvimento):
#
#   APP_ENV            dev            → prd-poc
#   PUBLIC_BASE_URL    localhost      → o domínio público, com https
#   CORS_ORIGENS       localhost:5173 → o mesmo domínio, e só ele
#   ORACLE_DSN         container      → nome do serviço do Autonomous Database
#   ORACLE_WALLET_DIR  vazio          → /app/wallet (montado pelo compose)
#   ORACLE_POOL_MAX    10             → 6 (o ADB gratuito tem teto de 20 sessões
#                                      e api + worker somariam 20, sem folga)
#   MYSQL_HOST         container      → endereço privado do HeatWave
#   MYSQL_SSL_MODE     DISABLED       → REQUIRED
#   PAINEL_TESTES_ATIVO true          → false (rota de teste não vai para o ar)
#   OTEL_..._ENDPOINT  jaeger         → vazio (Jaeger não sobe em 1 GB)
#
# ⚠️ TODO segredo está vazio aqui de propósito. Se você encontrar um valor
#    preenchido num campo de senha, chave ou token, é defeito — abra issue.
# ============================================================================

# ─────────── Deploy: consumidas pelo docker-compose.prod.yml ───────────
# Dono do pacote no GitHub Container Registry (seu usuário, em minúsculas).
GHCR_OWNER=leonardolabdc
# Etiqueta da imagem a rodar. É ISTO que o rollback muda — nunca use `latest`,
# porque `latest` não identifica versão nenhuma e o rollback deixa de existir.
IMAGE_TAG=
# Domínio público, sem https://
DOMINIO=SEU-SUBDOMINIO.duckdns.org
# E-mail para o Let's Encrypt avisar de expiração.
EMAIL_ACME=

# ============================================================================
# POC IA — Central de Monitoramento Bahrd
# Template de configuração. Copie para .env e preencha.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#
# Regra não negociável (doc 02, armadilha 2): a aplicação NUNCA lê arquivo de
# configuração. Tudo chega por os.environ, atrás de um Settings do Pydantic.
# Este arquivo existe só para o Docker exportar as variáveis.
#
# ⚠️ Comentário só em linha própria. O `--env-file` do Docker não corta
#    comentário no fim da linha — `APP_ENV=dev  # comentário` vira o valor
#    literal "dev  # comentário" e quebra a validação.
#
# Fase 2 (OCI): os itens marcados com ◄ passam a vir do OCI Vault e este
# arquivo deixa de existir.
# ============================================================================

# ─────────── Aplicação ───────────
# APP_ENV: dev | hml | prd-poc
APP_ENV=prd-poc
APP_NOME=central-ia
# Fase 2: https://webhook.poc.bahrd.com.br
PUBLIC_BASE_URL=https://SEU-SUBDOMINIO.duckdns.org
LOG_LEVEL=INFO
# LOG_FORMATO: json | console (console só em dev local)
LOG_FORMATO=json
KILL_SWITCH_ATIVO=false
# ⚠️ Deixa a IA conduzir pânico sem entregar ao operador. Contraria o princípio
# 3 (evento crítico é exclusivamente humano) e existe para medir a classificação
# contra dados reais antes de qualquer decisão sobre supressão.
# **Não vai para produção assim.**
PANICO_AUTONOMO=false


# ⛔ A triagem previa dos eventos criticos. `true` em producao, sempre.
#
# Com `false` ela NAO RODA: o panico corre como remocao de bateria, a IA abre
# com o template, conduz pelo PB-PANICO e pode encerrar sozinha. Ninguem avalia
# o caso antes do primeiro contato.
#
# Existe so enquanto a FONTE_RASTREAMENTO for `amostra`: sem posicao, rota nem
# historico, a triagem decide no escuro e manda todo panico de teste para a
# fila humana. Quando a API da Bahrd entrar, esta chave sai e a filtragem de
# casos possivelmente reais volta com dado de verdade. Ver config.py.
TRIAGEM_PREVIA_ATIVA=true

# MODO_VOZ: voz_simulada | voz_livekit_sip
MODO_VOZ=voz_simulada
# SECRET_PROVIDER: env | oci_vault
SECRET_PROVIDER=env
# Origens autorizadas a chamar a API pelo browser (JSON). Em produção, o
# domínio do painel — nunca "*".
CORS_ORIGENS=["https://SEU-SUBDOMINIO.duckdns.org"]

# Tranca das rotas /painel/*, no cabeçalho X-Painel-Token.
#
# Vazio deixa o painel aberto — cômodo em desenvolvimento, e a API avisa no
# boot quando está assim. Preencha antes de expor por túnel ou receber evento
# real: o túnel é aberto para o Twilio alcançar /whatsapp/entrada e expõe a
# API inteira junto, inclusive a fila com nome, placa e endereço.
#
# As duas variáveis levam o mesmo valor: a primeira é exigida pela API, a
# segunda é o que o painel envia. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAINEL_TOKEN=
VITE_PAINEL_TOKEN=

# A Central pode disparar evento de teste pela tela do painel?
#
# Desligada por padrão. Ligada, a tela manda WhatsApp de VERDADE pelo número
# oficial verificado da Bahrd, para um celular escolhido por uma pessoa. Em
# produção o código ignora esta variável e mantém a tela desligada.
#
# ⚠️ Não existe lista de destinos: o número é digitado na tela. Havia uma, e ela
# saiu em 03/09/2026 porque obrigava a chamar o dev para cadastrar cada celular
# novo, que é o que esta tela existe para evitar. O que sobrou contra disparo
# para o número errado é o PAINEL_TOKEN, o teto de 50 por dia e a validação de
# formato — que pega o dígito faltando, mas não o dígito trocado.
PAINEL_TESTES_ATIVO=false

# ─────────── Modelo de linguagem ───────────
# Quem atende. `anthropic` fala direto — um salto de rede a menos e saídas
# estruturadas; `openrouter` passa por um intermediário e dá vários modelos com
# uma chave só, que é o que a POC usa hoje.
LLM_PROVIDER=anthropic

# ─────────── Claude (Anthropic) ───────────
# ◄ Vault
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO_PRINCIPAL=claude-opus-5
# Quanto o modelo pode raciocinar por tipo de chamada. Mexe em custo e latência
# ao mesmo tempo — ver `agent/esforco.py`.
ANTHROPIC_EFFORT_VOZ=low
ANTHROPIC_EFFORT_TEXTO=medium
ANTHROPIC_EFFORT_TRIAGEM=high

# ─────────── OpenRouter ───────────
# Só é lido quando LLM_PROVIDER=openrouter.
# ◄ Vault
OPENROUTER_API_KEY=
OPENROUTER_MODELO=anthropic/claude-sonnet-5

# ─────────── STT / TTS ───────────
# ◄ Vault
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-BR
# ◄ Vault
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_VOZ=eleven_flash_v2_5
ELEVENLABS_MODEL_AUDIO=eleven_v3
# Conforme o codec negociado com o GoTo
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
CARTESIA_API_KEY=

# ─────────── Twilio (WhatsApp de teste) ───────────
# Sandbox: manda e recebe WhatsApp sem verificação de empresa na Meta e sem
# depender da TI da Bahrd. Passo a passo em docs/09-twilio-whatsapp.md.
TWILIO_ACCOUNT_SID=
# ◄ Vault
TWILIO_AUTH_TOKEN=
# Número do sandbox. O prefixo "whatsapp:" faz parte do valor.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Quem pode ABRIR ocorrência por mensagem. Separe por vírgula.
# Vazio = ninguém abre, e é assim que deve ficar se a URL do webhook vazar.
#
# Desde 03/09/2026 esta lista governa também PARA QUEM a IA pode escrever
# quando um evento chega em /eventos/link, e fora de produção ela vale sempre,
# com assinatura ou sem. Vazia, nenhum evento de teste chega em celular nenhum.
# Não precisa escrever as duas grafias do mesmo número: o código já compara
# com e sem o nono dígito, e já ignora o prefixo "whatsapp:".
TWILIO_NUMEROS_DE_TESTE=

# A URL pública que o Twilio chama. Com túnel, é o endereço do túnel — e tem de
# bater EXATAMENTE com o cadastrado lá, senão a assinatura não confere.
# PUBLIC_BASE_URL=https://algo.ngrok-free.app

# ─────────── WhatsApp Cloud API (Meta) ───────────
# ⛔ Este bloco chamava-se WHATSAPP_* e **nenhuma daquelas variáveis era lida** —
# o adaptador sempre leu META_*. Quem preenchesse o token lá não via efeito
# nenhum, e a configuração que mente é pior que a que não existe.
#
# Desde 09/09/2026 isso não passa mais em silêncio: os campos mortos saíram do
# `config.py` e a aplicação **recusa subir** se encontrar WHATSAPP_TOKEN,
# WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET ou
# WHATSAPP_API_VERSION preenchidas, dizendo o nome novo de cada uma. Antes, o
# sintoma era um WhatsApp mudo sem nenhum erro em lugar nenhum.
#
# Qual adaptador entrega a mensagem. `twilio` é o sandbox de teste; `meta` é a
# API oficial, sem intermediário e sem a taxa por mensagem que o Twilio cobra
# por cima da tarifa da própria Meta (doc 12 §4). Os dois convivem no código —
# a POC roda em `meta`; o padrão aqui é `twilio` porque é o que funciona sem
# empresa verificada.
CANAL_WHATSAPP=twilio

# Id do número remetente no painel da Meta. É um id, não o telefone.
META_PHONE_NUMBER_ID=
# ◄ Vault (System User, permanente)
META_ACCESS_TOKEN=
# Chave do `X-Hub-Signature-256`. Sem ela não há como distinguir a Meta de
# qualquer um que descubra a URL do webhook — ver doc 17 §6.
# ◄ Vault
META_APP_SECRET=
# Frase que você inventa e repete no painel da Meta, para o aperto de mão.
# ◄ Vault (definido por nós)
META_VERIFY_TOKEN=

# ─────────── Comportamento em produção ───────────
# Cinco variáveis que existem no código, mudam comportamento e faltavam aqui
# até 09/09/2026. Todas têm padrão, então o sistema sobe sem elas — o problema
# era ninguém saber que existem.

# A IA responde em áudio quando o cliente manda áudio. Ligada por padrão:
# quem mandou nota de voz está dirigindo e não vai parar para ler.
# ⚠️ É a variável que mais mexe na conta. A ElevenLabs custa ~R$ 0,22 por
# atendimento falado, quase o dobro da IA inteira (doc 06). Desligar aqui é a
# maior economia disponível sem trocar fornecedor nenhum.
WHATSAPP_RESPONDER_EM_AUDIO=true

# De onde vêm ficha do veículo, posição e histórico.
# `amostra` = dados de exemplo, embutidos no código. `link` = API real deles.
# ⛔ Enquanto estiver `amostra`, o sistema NÃO fala com a Bahrd — nem para ler
# nem para escrever. Subir em produção sem trocar isto dá um sistema que
# atende clientes de verdade decidindo sobre veículos que não existem.
FONTE_RASTREAMENTO=amostra

# A IA pode passar um caso para humano? Nasce desligada de propósito: sem a
# plataforma de atendimento decidida (doc 10), escalar não tem para onde ir.
ESCALONAMENTO_HUMANO_ATIVO=false

# Endpoints dos fornecedores. Só mexer para apontar para sandbox ou proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TWILIO_BASE_URL=https://api.twilio.com

# ─────────── GoTo Connect (SIP) ───────────
SIP_DOMAIN=reg.jiveip.net
# <conta>.jive.rtcfront.net
SIP_OUTBOUND_PROXY=
SIP_PORT=5060
SIP_USERNAME=
# ◄ Vault
SIP_PASSWORD=
SIP_CALLER_ID=
SIP_CODEC=PCMU
# Destino do SIP REFER no handoff
SIP_RAMAL_OPERADOR=

# ─────────── LiveKit ───────────
# Fase 2: wss://livekit.poc.bahrd.com.br
LIVEKIT_URL=ws://livekit:7880
# ◄ Vault
LIVEKIT_API_KEY=
# ◄ Vault
LIVEKIT_API_SECRET=

# ─────────── Oracle (Free em container / ADB-S na Fase 2) ───────────
ORACLE_USER=CENTRAL_IA
# ◄ Vault
ORACLE_PASSWORD=
# Fase 2: pociacentral_tp
ORACLE_DSN=bahrddb_tp
# Só na Fase 2
ORACLE_WALLET_DIR=/app/wallet
# ◄ Vault (Fase 2)
ORACLE_WALLET_PASSWORD=
ORACLE_LEGADO_SCHEMA=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=6
# Senha do SYS no container local — não existe na Fase 2 (ADB-S não dá SYS)
ORACLE_SYS_PASSWORD=
# Retenção da BLOCKCHAIN TABLE de auditoria: 0 em dev (permite recriar o
# schema), 31 em hml/prd-poc. Ver migrations/oracle/001_schema_base.sql.
ORACLE_AUDITORIA_DIAS_IDLE=31

# ─────────── MySQL ───────────
# Fase 2: endpoint privado do MySQL HeatWave
MYSQL_HOST=10.0.1.XXX
MYSQL_PORT=3306
MYSQL_DATABASE=central_ia_op
MYSQL_USER=central_ia
# ◄ Vault
MYSQL_PASSWORD=
# Só no container local
MYSQL_ROOT_PASSWORD=
# MYSQL_SSL_MODE: DISABLED | PREFERRED | REQUIRED (Fase 2: REQUIRED)
MYSQL_SSL_MODE=REQUIRED

# ─────────── Redis ───────────
# Fase 2: OCI Cache (endpoint privado)
REDIS_HOST=redis
REDIS_PORT=6379
# ◄ Vault (Fase 2)
REDIS_AUTH_TOKEN=
REDIS_STREAM_EVENTOS=eventos.rastreamento

# ─────────── Object storage (MinIO → OCI Object Storage) ───────────
# Fase 2: endpoint S3-compatível da OCI
S3_ENDPOINT=http://minio:9000
S3_REGIAO=sa-saopaulo-1
S3_BUCKET=poc-ia-audio
# ◄ Vault (Fase 2: instance principal)
S3_ACCESS_KEY=
# ◄ Vault
S3_SECRET_KEY=

# ─────────── Sistema próprio da Bahrd ───────────
# ⚠️ O valor abaixo é um PLACEHOLDER e está versionado neste arquivo desde
# d62f5b1. Quem lê o repositório consegue assinar um POST /eventos/link válido.
# Trocar pelo segredo real combinado com a TI é pré-requisito do primeiro
# evento real, não uma melhoria.
#
# Ele NÃO desliga mais a lista de destinos autorizados: até 03/09/2026 bastava
# preencher este campo para TWILIO_NUMEROS_DE_TESTE parar de valer, o que fazia
# a configuração preenchida ser mais frouxa que a vazia. Hoje quem manda nessa
# trava é APP_ENV.
# ◄ Vault
BAHRD_WEBHOOK_HMAC_SECRET=
BAHRD_API_BASE_URL=
# ◄ Vault
BAHRD_API_TOKEN=
# BAHRD_MODO_INGESTAO: webhook | polling
BAHRD_MODO_INGESTAO=webhook

# ─────────── OCI (Fase 2; identidade vem de instance principal) ───────────
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_OCID=
OCI_VAULT_OCID=
OCI_KMS_KEY_OCID=
OCI_NAMESPACE=

# ─────────── Autenticação do painel (Fase 2) ───────────
OIDC_ISSUER=
OIDC_CLIENT_ID=
# ◄ Vault
OIDC_CLIENT_SECRET=

# ─────────── Observabilidade ───────────
# Fase 2: OCI APM
OTEL_EXPORTER_OTLP_ENDPOINT=
# ◄ Vault (Fase 2)
OTEL_EXPORTER_OTLP_HEADERS=

# ─────────── Langfuse ───────────
# Observabilidade de LLM: mostra a conversa turno a turno, agrupada por
# ocorrência, com custo e tokens ao lado. Recebe os MESMOS spans do Jaeger —
# ligar um não desliga o outro. Chaves em Configurações > API Keys do projeto.
# Vazio = desligado, e nenhum código extra roda.
LANGFUSE_PUBLIC_KEY=
# ◄ Vault
LANGFUSE_SECRET_KEY=
# Região da UE. Outras: https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# A TRANCA DO CONTEÚDO. Desligada, o Langfuse recebe só metadado (modelo,
# tokens, custo, desfecho) — nunca o texto.
#
# `true` manda prompt e resposta para a nuvem do Langfuse. Num atendimento real
# isso inclui nome de motorista, placa e endereço, então ligue apenas em
# máquina de desenvolvimento e com dado fictício. Em produção a aplicação
# ignora esta variável e não envia conteúdo de jeito nenhum.
LANGFUSE_ENVIAR_CONTEUDO=false

# ─────────── Front-end ───────────
VITE_API_BASE_URL=

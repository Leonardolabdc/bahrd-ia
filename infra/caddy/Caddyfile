# ============================================================================
# Borda do Bahrd — TLS, roteamento e cabeçalhos de segurança.
#
# O Caddy pede e renova o certificado do Let's Encrypt sozinho, desde que a
# porta 80 esteja alcançável e o DNS já aponte para esta máquina. Não há
# certbot, não há cron de renovação, não há certificado para expirar num
# domingo.
#
# O volume `caddy-dados` guarda os certificados. Apagá-lo força um ACME novo —
# e o Let's Encrypt limita 5 emissões por domínio por semana, então não apague
# por reflexo durante um incidente.
# ============================================================================
{
	email {$EMAIL_ACME}
}

{$DOMINIO} {
	encode zstd gzip

	# ── Cabeçalhos ──────────────────────────────────────────────────────
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O Caddy anuncia a si mesmo por padrão; versão de servidor é
		# informação gratuita para quem varre.
		-Server
	}

	# ── API ─────────────────────────────────────────────────────────────
	# Os prefixos são os routers de `api/main.py`. Tudo o que não estiver
	# aqui é do painel — a ordem importa: o handle_path do SPA é o último.
	@api path /saude/* /painel/* /whatsapp/* /eventos/* /midia/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto https

			# O token do painel é injetado AQUI, e não entregue ao navegador.
			#
			# A alternativa seria escrevê-lo em /config.js, que o SPA lê no boot
			# — mas /config.js é servido a qualquer visitante, então publicar o
			# segredo ali o reduziria a zero.
			#
			# Assim ele passa a ser o que sempre deveria ter sido: credencial
			# entre a borda e a API, nunca do lado do cliente.
			#
			# ⚠️ Isto NÃO é o login. É a credencial entre a borda e a API, e
			#    sozinha não diz quem está usando. Quem entra no painel é
			#    decidido pela API: usuário e senha de PAINEL_USUARIOS, sessão
			#    em cookie HttpOnly, perfis admin e operador. Fechou a lacuna 12
			#    da auditoria. As duas trancas valem juntas em /painel/*.
			#
			# O `X-Forwarded-Proto https` de cima também é do login: é por ele
			# que a API sabe marcar o cookie da sessão como Secure.
			header_up X-Painel-Token {$PAINEL_TOKEN}
		}
	}

	# ── Painel (SPA) ────────────────────────────────────────────────────
	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format json
	}
}
